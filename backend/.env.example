# ==============================================================================
# CCS CONNECT ERP — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env in your production environment and provide secure values.
# NEVER commit real production credentials to version control.
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=0
# Generate a strong 64+ char random secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-50-characters

# Comma-separated list of fully qualified domain names and IP addresses allowed to serve traffic
DJANGO_ALLOWED_HOSTS=api.ccsconnect.com,ccssoftware-dbb3.vercel.app,127.0.0.1

# Database Configuration (PostgreSQL is required as the source of truth)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://ccs_user:strong_production_database_password_here@127.0.0.1:5432/ccs

# Redis Configuration (Required for Channel Layers / Real-Time Events)
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://:strong_redis_password_if_configured@127.0.0.1:6379/0
USE_REDIS=1

# JWT Signing Key (Optional, defaults to DJANGO_SECRET_KEY. Must be >= 32 chars for HMAC-SHA256)
JWT_SIGNING_KEY=optional-separate-jwt-signing-key-minimum-32-chars-long

# CORS & CSRF Trusted Origins (Comma-separated)
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://ccssoftware-dbb3.vercel.app,https://app.ccsconnect.com
CSRF_TRUSTED_ORIGINS=https://ccssoftware-dbb3.vercel.app,https://app.ccsconnect.com

# SSL & Security Headers
DJANGO_SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Logging
DJANGO_LOG_LEVEL=INFO

# Outgoing SMTP Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=chitracropscience@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-specific-password
DEFAULT_FROM_EMAIL=Chitra Crop Science <chitracropscience@gmail.com>
