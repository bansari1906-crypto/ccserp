# ==============================================================================
# CCS CONNECT ERP — PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Target Host: Ubuntu 24.04 LTS VPS
# Target Domain: chitracropsciencepartners.com
# File Location on VPS: /var/www/ccs-connect/backend/.env
# Permissions: chmod 600 /var/www/ccs-connect/backend/.env (Owner: www-data:www-data)
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=0

# Secret Key (Generate on VPS via: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_50_CHAR_SECRET_KEY

# Allowed Hosts (Exact domain & local addresses)
DJANGO_ALLOWED_HOSTS=chitracropsciencepartners.com,www.chitracropsciencepartners.com,127.0.0.1,localhost

# Database Connection (PostgreSQL 16 on VPS)
# Format: postgresql://<user>:<password>@127.0.0.1:5432/<dbname>
DATABASE_URL=postgresql://ccs_user:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/ccs

# Redis 7 (In-memory channel layer for Django Channels / WebSockets)
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=1

# JWT Signing Key (Optional, minimum 32 chars)
JWT_SIGNING_KEY=REPLACE_WITH_SECURE_JWT_SIGNING_KEY_MIN_32_CHARS

# CORS & CSRF Trusted Origins
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://chitracropsciencepartners.com,https://www.chitracropsciencepartners.com,capacitor://localhost
CSRF_TRUSTED_ORIGINS=https://chitracropsciencepartners.com,https://www.chitracropsciencepartners.com

# SSL & Security Transport
DJANGO_SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# Logging
DJANGO_LOG_LEVEL=INFO

# Outgoing SMTP Email Configuration (Optional / As needed)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=chitracropscience@gmail.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_GOOGLE_APP_SPECIFIC_PASSWORD
DEFAULT_FROM_EMAIL=Chitra Crop Science <chitracropscience@gmail.com>
