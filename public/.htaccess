<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Directly serve Android APK with correct headers and MIME type if file exists locally
  <FilesMatch "\.(apk)$">
    Header set Content-Type "application/vnd.android.package-archive"
    Header set Content-Disposition "attachment; filename=\"CCS-Connect.apk\""
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # If downloads/CCS-Connect.apk exists locally on Hostinger, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^downloads/CCS-Connect\.apk$ - [L]

  # Route API requests to live backend endpoint (Configurable in Hostinger or Reverse Proxy)
  # RewriteRule ^api/(.*)$ https://BACKEND_HOST/api/$1 [P,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>
